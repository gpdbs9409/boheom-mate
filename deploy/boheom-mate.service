[Unit]
Description=boheom-mate Streamlit app
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/boheom-mate
ExecStart=/home/ubuntu/boheom-mate/.venv/bin/streamlit run app.py --server.port 8501 --server.address 127.0.0.1 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
